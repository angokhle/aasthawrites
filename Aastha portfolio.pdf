872 0 obj
<</Type/StructElem/S/P/P 108 0 R/E(Unheard whimpers, shoved under the bear rug -)/Pg 38 0 R/K[8]>>
endobj

873 0 obj
<</Type/StructElem/S/P/P 108 0 R/E(silenced amidst the buzzing sonata of honey rearing bees; fur around the shoulders for lifeless warmth -)/Pg 38 0 R/K[9]>>
endobj

874 0 obj
<</Type/StructElem/S/P/P 108 0 R/E(countless lives shredded for their skins.)/Pg 38 0 R/K[10]>>
endobj

875 0 obj
<</Type/StructElem/S/P/P 108 0 R/E(Branded leather thumping against the floor)/Pg 38 0 R/K[11]>>
endobj

876 0 obj
<</Type/StructElem/S/P/P 108 0 R/E(like a God strolling amidst his tiny subjects)/Pg 38 0 R/K[12]>>
endobj

877 0 obj
<</Type/StructElem/S/P/P 108 0 R/E(the wearer unbeknownst to what lurks beneath)/Pg 38 0 R/K[13]>>
endobj

878 0 obj
<</Type/StructElem/S/P/P 108 0 R/E(strides along a path he built.)/Pg 38 0 R/K[14]>>
endobj

879 0 obj
<</Type/StructElem/S/P/P 108 0 R/E(In the soft, cold breeze of late Delhi winters)/Pg 38 0 R/K[15]>>
endobj

880 0 obj
<</Type/StructElem/S/P/P 108 0 R/E(I was met with a newfound affection for the city I once called home.)/Pg 38 0 R/K[16]>>
